class_name ScoringCardDefinition
extends RefCounted

# Each entry stores the title, full rule and sidebar summary.
const DETAILS = {
	"crab": {
		"A": ["掘穴守潮","每只招潮蟹得 2 分。脚下有泥滩就再加 1 分。","泥滩多 1 分"],
		"B": ["开口迎潮","每只招潮蟹先得 1 分。数它脚下地块周围的未铺空位。每两个空位加 1 分，剩一个也加 1 分。","留出空位"],
		"C": ["滩面食盘","每只招潮蟹得 1 分。挨在一起的招潮蟹算一群。紧挨蟹群的空地块每格加 3 分，同一群每格只算一次。一群有几只蟹，最多就数它们两倍的空地块。","给蟹群留空地"],
		"D": ["潮线采样","每只招潮蟹得 1 分。挨在一起的招潮蟹算一群。只看群外地块朝向蟹群的那条边，每种地貌加 1 分。同一群里同种地貌只算一次，每只蟹最多给这群带来 2 分加分额度。","认蟹群外的边"]
	},
	"limpet": {
		"A": ["岩面啃藻","每只帽贝先得 1 分。脚下和周围紧挨着的地块里，每块只要有岩礁就加 1 分，最多加 2 分。","找岩礁"],
		"B": ["两岸消浪","每只帽贝先得 1 分。看穿过它的三条直线。每条线上，紧挨它、正对的两侧都有地块，就加 1 分。","两侧正对都有地"],
		"C": ["归壳潮痕","每只帽贝先得 1 分。看脚下地块和紧邻地块相接的边。只要有一对边的地貌相同，就加 2 分。对上几处都只加一次。","相接边地貌相同"],
		"D": ["壳层标本","每只帽贝得 1 分。再看所有帽贝脚下的地貌，每种不同的地貌组合加 1 分。比如岩礁和岩礁＋潮池各算一种，同一组合转个方向还是同一种。","收集不同地貌组合"]
	},
	"tern": {
		"A": ["迎风起飞","每只燕鸥先得 1 分。绕着它看一圈，如果有两个连着的未铺空位，就加 2 分。只加一次。","留两个连着的空位"],
		"B": ["掠岸航道","每只燕鸥先得 1 分。沿每个方向直着看两格：第一格有地块，第二格没铺，这个方向就加 1 分，最多加 2 分。","跨一块地就出海"],
		"C": ["衔鱼归巢","每只燕鸥先得 1 分。从它出发，只走已铺地块，每次跨一条边。两步以内碰到弹涂鱼就加 2 分，几只燕鸥可以找同一条鱼。","两步内找到鱼"],
		"D": ["迁徙落脚点","每只燕鸥得 1 分。从燕鸥直着跨过一块地，第二格有砾滩或盐沼就加 1 分。全岛同一落脚格只算一次。全岛有几只燕鸥，最多就数它们两倍的落脚格。","跨地找落脚点"]
	},
	"goby": {
		"A": ["湿泥换气","每只弹涂鱼得 1 分。脚下有泥滩或潮池就加 2 分，即使两种都有也只加一次。","住泥滩或潮池"],
		"B": ["跨滩换位","每只弹涂鱼先得 1 分。紧挨它的地块如果和脚下完全没有相同的地貌，就加 1 分。每块这样的地各算一次，最多加 2 分。","邻地地貌全不同"],
		"C": ["干湿轮替","每只弹涂鱼先得 1 分。看脚下和紧挨的地块，只要泥滩和潮池两种都找得到，就加 2 分。它们可以在同一块地上。","泥滩和潮池都要"],
		"D": ["横穿潮沟","每只弹涂鱼先得 2 分。看穿过它的三条直线。如果紧挨它、正对的两侧，一边有泥滩、另一边有潮池，这条线就加 2 分。每条线只算一次。","泥滩潮池正对"]
	},
	"otter": {
		"A": ["翻石觅食","每只水獭先得 1 分。看紧挨着它的地块，招潮蟹、帽贝、弹涂鱼每看见一种就加 1 分。同种来几只都只加 1 分。","找三种猎物"],
		"B": ["背风育幼湾","每只水獭先得 1 分。绕着它看一圈，如果有三个连着的位置都铺了地块，就加 2 分。只加一次。","三块地围一侧"],
		"C": ["上岸晾毛","每只水獭先得 1 分。旁边只要有一块没有动物的砾滩或岩礁，就加 4 分。每只水獭只加一次，几只可以用同一块地。","留块空砾滩或岩礁"],
		"D": ["水域巡护","每只水獭得 1 分。只要它脚下或旁边有一块带潮池的地，就能给整片潮池加分。两块地相接的边都是潮池才算同一片。每片每块地加 1 分，最多加 3 分。同一片有几只水獭都只算一次。","给连片潮池加分"]
	}
}

static func title(animal: String, card: String) -> String:
	return GameLocale.text(DETAILS[animal][card][0])

static func description(animal: String, card: String) -> String:
	return GameLocale.text(DETAILS[animal][card][1])

static func summary(animal: String, card: String) -> String:
	return GameLocale.text(DETAILS[animal][card][2])
