"events": [Object(InputEventKey,"keycode":4194309), Object(InputEventKey,"keycode":4194310)]
}

turn_undo={
"deadzone": 0.2,
"events": [Object(InputEventKey,"keycode":4194305), Object(InputEventJoypadButton,"device":-1,"button_index":1)]
}

board_place={
