; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="潮痕群岛"
config/icon="res://assets/art/crab.svg"
config/version="1.2.0"
config/description="在退潮的群岛拼接五种生境，记录潮间带动物的生活。"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[updates]

github_repository=""

[autoload]

_mcp_game_helper="*res://addons/godot_ai/runtime/game_helper.gd"

[debug]

gdscript/warnings/inference_on_variant=0

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_ai/plugin.cfg")

[rendering]

textures/vram_compression/import_etc2_astc=true

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.07, 0.14, 0.12, 1)

[input]

market_row_1={
"deadzone": 0.2,
"events": [Object(InputEventKey,"keycode":49)]
}

market_row_2={
"deadzone": 0.2,
"events": [Object(InputEventKey,"keycode":50)]
}

market_row_3={
"deadzone": 0.2,
"events": [Object(InputEventKey,"keycode":51)]
}

market_row_4={
"deadzone": 0.2,
"events": [Object(InputEventKey,"keycode":52)]
}

