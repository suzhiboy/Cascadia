msgid "旅行者 %d"
msgstr "旅行者 %d"

msgid "四枚同种动物过剩，已自动更换。"
msgstr "四枚同种动物过剩，已自动更换。"

msgid "请在选取地块前使用。"
msgstr "请在选取地块前使用。"

msgid "请选择至少一枚动物。"
msgstr "请选择至少一枚动物。"

msgid "无效的动物选择。"
msgstr "无效的动物选择。"

msgid "自然标记不足。"
msgstr "自然标记不足。"

msgid "每回合仅可免费更换一次三枚同种动物。"
msgstr "每回合仅可免费更换一次三枚同种动物。"

msgid "请选择三枚同种动物。"
msgstr "请选择三枚同种动物。"

msgid "请先完成当前回合。"
msgstr "请先完成当前回合。"

msgid "请选择市场中的地块与动物。"
msgstr "请选择市场中的地块与动物。"

msgid "跨组选取需要一枚自然标记。"
msgstr "跨组选取需要一枚自然标记。"

msgid "请先从市场选取。"
msgstr "请先从市场选取。"

msgid "地块须与已有地块共边，且不能重叠。"
msgstr "地块须与已有地块共边，且不能重叠。"

msgid "动物须放在有对应图标、且尚未入住的地块。"
msgstr "动物须放在有对应图标、且尚未入住的地块。"

msgid "请先选取动物。"
msgstr "请先选取动物。"

msgid "请摆放地块，并安置动物或选择放归。"
msgstr "请摆放地块，并安置动物或选择放归。"

msgid "未知的联机操作。"
msgstr "未知的联机操作。"

msgid "存档不兼容"
msgstr "存档不兼容"

msgid "巡护潮池"
msgstr "巡护潮池"

msgid "掘穴守潮"
msgstr "掘穴守潮"

msgid "每只招潮蟹得 2 分。脚下有泥滩就再加 1 分。"
msgstr "每只招潮蟹得 2 分。脚下有泥滩就再加 1 分。"

msgid "泥滩多 1 分"
msgstr "泥滩多 1 分"

msgid "开口迎潮"
msgstr "开口迎潮"

msgid "每只招潮蟹先得 1 分。数它脚下地块周围的未铺空位。每两个空位加 1 分，剩一个也加 1 分。"
msgstr "每只招潮蟹先得 1 分。数它脚下地块周围的未铺空位。每两个空位加 1 分，剩一个也加 1 分。"

msgid "留出空位"
msgstr "留出空位"

msgid "三角蟹阵"
msgstr "三角蟹阵"

msgid "共边的招潮蟹算一群。每群只数一个最好的形状：单只、相邻两只、三只彼此相邻的小三角，分别得 {scores} 分。群里其余每只得 {extra} 分。"
msgstr "共边的招潮蟹算一群。每群只数一个最好的形状：单只、相邻两只、三只彼此相邻的小三角，分别得 {scores} 分。群里其余每只得 {extra} 分。"

msgid "三只围成小三角"
msgstr "三只围成小三角"

msgid "潮线采样"
msgstr "潮线采样"

msgid "每只招潮蟹得 1 分。挨在一起的招潮蟹算一群。只看群外地块朝向蟹群的那条边，每种地貌加 1 分。同一群里同种地貌只算一次，每只蟹最多给这群带来 2 分加分额度。"
msgstr "每只招潮蟹得 1 分。挨在一起的招潮蟹算一群。只看群外地块朝向蟹群的那条边，每种地貌加 1 分。同一群里同种地貌只算一次，每只蟹最多给这群带来 2 分加分额度。"

msgid "认蟹群外的边"
msgstr "认蟹群外的边"

msgid "岩面啃藻"
msgstr "岩面啃藻"

msgid "每只帽贝先得 1 分。脚下和周围紧挨着的地块里，每块只要有岩礁就加 1 分，最多加 2 分。"
msgstr "每只帽贝先得 1 分。脚下和周围紧挨着的地块里，每块只要有岩礁就加 1 分，最多加 2 分。"

msgid "找岩礁"
msgstr "找岩礁"

msgid "两岸消浪"
msgstr "两岸消浪"

msgid "每只帽贝先得 2 分。沿穿过它的三条直线看，只要紧挨它、正对的两侧都有地块，就再加 1 分。"
msgstr "每只帽贝先得 2 分。沿穿过它的三条直线看，只要紧挨它、正对的两侧都有地块，就再加 1 分。"

msgid "两侧正对都有地"
msgstr "两侧正对都有地"

msgid "归壳潮痕"
msgstr "归壳潮痕"

msgid "每只帽贝先得 1 分。数脚下地块和邻地相接的边，只有两边地貌相同才算。对上至少一处加 1 分，对上三处或更多再加 1 分。"
msgstr "每只帽贝先得 1 分。数脚下地块和邻地相接的边，只有两边地貌相同才算。对上至少一处加 1 分，对上三处或更多再加 1 分。"

msgid "相接边地貌相同"
msgstr "相接边地貌相同"

msgid "岩脊贝列"
msgstr "岩脊贝列"

msgid "共边的帽贝算一群。每群数最长的一条直线，中间不能断。线长 1 至 4 格分别得 {scores} 分，之后每多一格加 {step} 分。线外每只得 {extra} 分，同一群只算一条线。"
msgstr "共边的帽贝算一群。每群数最长的一条直线，中间不能断。线长 1 至 4 格分别得 {scores} 分，之后每多一格加 {step} 分。线外每只得 {extra} 分，同一群只算一条线。"

msgid "连成直线"
msgstr "连成直线"

msgid "迎风起飞"
msgstr "迎风起飞"

msgid "每只燕鸥先得 1 分。绕着它数连续的未铺空位，看最长的一段。连续两个加 1 分，连续三个或更多加 2 分。"
msgstr "每只燕鸥先得 1 分。绕着它数连续的未铺空位，看最长的一段。连续两个加 1 分，连续三个或更多加 2 分。"

msgid "留两个连着的空位"
msgstr "留两个连着的空位"

msgid "展翅分岔"
msgstr "展翅分岔"

msgid "每只燕鸥先得 1 分。沿着它的六条边看，若两个方向各有相邻地块，而且两方向之间刚好隔一条边，就组成一个叉口。每个叉口加 1 分，最多算两个。"
msgstr "每只燕鸥先得 1 分。沿着它的六条边看，若两个方向各有相邻地块，而且两方向之间刚好隔一条边，就组成一个叉口。每个叉口加 1 分，最多算两个。"

msgid "向两侧展翅"
msgstr "向两侧展翅"

msgid "跳岛鸟群"
msgstr "跳岛鸟群"

msgid "两只燕鸥若在同一直线上，中间恰好隔一块已铺地，就能结伴。沿这些连接找到整群，每只只数一次。每群 1 至 4 只分别得 {scores} 分，之后每多一只加 {step} 分。"
msgstr "两只燕鸥若在同一直线上，中间恰好隔一块已铺地，就能结伴。沿这些连接找到整群，每只只数一次。每群 1 至 4 只分别得 {scores} 分，之后每多一只加 {step} 分。"

msgid "隔一格结伴"
msgstr "隔一格结伴"

msgid "迁徙落脚点"
msgstr "迁徙落脚点"

msgid "每只燕鸥得 1 分。从燕鸥直着跨过一块地，第二格有砾滩或盐沼就加 1 分。全岛同一落脚格只算一次。全岛有几只燕鸥，最多就数它们两倍的落脚格。"
msgstr "每只燕鸥得 1 分。从燕鸥直着跨过一块地，第二格有砾滩或盐沼就加 1 分。全岛同一落脚格只算一次。全岛有几只燕鸥，最多就数它们两倍的落脚格。"

msgid "跨地找落脚点"
msgstr "跨地找落脚点"

msgid "湿泥换气"
msgstr "湿泥换气"

msgid "每只弹涂鱼得 1 分。脚下有泥滩或潮池就加 2 分，即使两种都有也只加一次。"
msgstr "每只弹涂鱼得 1 分。脚下有泥滩或潮池就加 2 分，即使两种都有也只加一次。"

msgid "住泥滩或潮池"
msgstr "住泥滩或潮池"

msgid "跨滩换位"
msgstr "跨滩换位"

msgid "每只弹涂鱼先得 2 分。只要旁边有一块地与脚下完全没有相同地貌，就再加 1 分。"
msgstr "每只弹涂鱼先得 2 分。只要旁边有一块地与脚下完全没有相同地貌，就再加 1 分。"

msgid "邻地地貌全不同"
msgstr "邻地地貌全不同"

msgid "聚潮鱼群"
msgstr "聚潮鱼群"

msgid "共边的弹涂鱼组成一群，可以拐弯或分叉。每群单独数，1 至 4 只分别得 {scores} 分，之后每多一只加 {step} 分。"
msgstr "共边的弹涂鱼组成一群，可以拐弯或分叉。每群单独数，1 至 4 只分别得 {scores} 分，之后每多一只加 {step} 分。"

msgid "鱼群连成片"
msgstr "鱼群连成片"

msgid "横穿潮沟"
msgstr "横穿潮沟"

msgid "每只弹涂鱼先得 2 分。看穿过它的三条直线，两头紧挨的地块要一边有泥滩、另一边有潮池。第一条符合的线加 2 分，之后每条加 1 分。"
msgstr "每只弹涂鱼先得 2 分。看穿过它的三条直线，两头紧挨的地块要一边有泥滩、另一边有潮池。第一条符合的线加 2 分，之后每条加 1 分。"

msgid "泥滩潮池正对"
msgstr "泥滩潮池正对"

msgid "翻石觅食"
msgstr "翻石觅食"

msgid "每只水獭先得 1 分。看紧挨着它的地块，招潮蟹、帽贝、弹涂鱼每看见一种就加 1 分。同种来几只都只加 1 分。"
msgstr "每只水獭先得 1 分。看紧挨着它的地块，招潮蟹、帽贝、弹涂鱼每看见一种就加 1 分。同种来几只都只加 1 分。"

msgid "找三种猎物"
msgstr "找三种猎物"

msgid "背风育幼湾"
msgstr "背风育幼湾"

msgid "每只水獭先得 1 分。绕着它看一圈，如果有三个连着的位置都铺了地块，就加 2 分。只加一次。"
msgstr "每只水獭先得 1 分。绕着它看一圈，如果有三个连着的位置都铺了地块，就加 2 分。只加一次。"

msgid "三块地围一侧"
msgstr "三块地围一侧"

msgid "结伴浮游"
msgstr "结伴浮游"

msgid "两只水獭共边，且都没有挨着第三只水獭，就算一对。全岛有 1 至 4 对分别得 {scores} 分，之后每多一对加 {step} 分。没配成对的水獭每只得 {extra} 分。"
msgstr "两只水獭共边，且都没有挨着第三只水獭，就算一对。全岛有 1 至 4 对分别得 {scores} 分，之后每多一对加 {step} 分。没配成对的水獭每只得 {extra} 分。"

msgid "两两结对"
msgstr "两两结对"

msgid "水域巡护"
msgstr "水域巡护"

msgid "每只水獭得 1 分。它脚下或旁边有潮池，就巡护整片。相接边都是潮池才连成一片。每片先加 1 分，再按地块每块加 1 分，最多数三块。几只水獭巡同一片只算一次。"
msgstr "每只水獭得 1 分。它脚下或旁边有潮池，就巡护整片。相接边都是潮池才连成一片。每片先加 1 分，再按地块每块加 1 分，最多数三块。几只水獭巡同一片只算一次。"

msgid "给连片潮池加分"
msgstr "给连片潮池加分"

msgid "招潮蟹"
msgstr "招潮蟹"

msgid "帽贝"
msgstr "帽贝"

msgid "弹涂鱼"
msgstr "弹涂鱼"

msgid "燕鸥"
msgstr "燕鸥"

msgid "水獭"
msgstr "水獭"

msgid "岩礁"
msgstr "岩礁"

msgid "盐沼"
msgstr "盐沼"

msgid "砾滩"
msgstr "砾滩"

msgid "泥滩"
msgstr "泥滩"

msgid "潮池"
msgstr "潮池"

msgid "联机协议版本不兼容。"
msgstr "联机协议版本不兼容。"

msgid "无效的联机命令。"
msgstr "无效的联机命令。"

msgid "无效的联机参数。"
msgstr "无效的联机参数。"

msgid "房主"
msgstr "房主"

msgid "只有未开始的房主可以开局。"
msgstr "只有未开始的房主可以开局。"

msgid "请等待所有玩家连接并准备。"
msgstr "请等待所有玩家连接并准备。"

msgid "重连超时，联机房间已结束。"
msgstr "重连超时，联机房间已结束。"

msgid "玩家重连超时，房间已结束。"
msgstr "玩家重连超时，房间已结束。"

msgid "还没轮到这位玩家。"
msgstr "还没轮到这位玩家。"

msgid "操作已处理，请勿重复发送。"
msgstr "操作已处理，请勿重复发送。"

msgid "版本不同，请两位玩家使用同一份最新游戏包。"
msgstr "版本不同，请两位玩家使用同一份最新游戏包。"

msgid "房间已开局，不能加入新玩家。"
msgstr "房间已开局，不能加入新玩家。"

msgid "房间已满，请选择其他房间。"
msgstr "房间已满，请选择其他房间。"

msgid "旅行者"
msgstr "旅行者"

msgid "连接失败。请检查房主热点 IPv4 地址、UDP 35721 防火墙放行及热点是否允许设备互访。"
msgstr "连接失败。请检查房主热点 IPv4 地址、UDP 35721 防火墙放行及热点是否允许设备互访。"

msgid "入住："
msgstr "入住："

msgid "可入住："
msgstr "可入住："

msgid "选取一组"
msgstr "选取一组"

msgid "点击左侧金边的第 1 组。点地块或弹涂鱼都可以，两件会一起选中。"
msgstr "点击左侧金边的第 1 组。点地块或弹涂鱼都可以，两件会一起选中。"

msgid "领取样区"
msgstr "领取样区"

msgid "点击市集下方的「确认选取」，把这组地块和弹涂鱼领取样区。"
msgstr "点击市集下方的「确认选取」，把这组地块和弹涂鱼领取样区。"

msgid "转一转地块"
msgstr "转一转地块"

msgid "按 E 或点击「E ↷」，把新地块的泥滩转向右下方，对齐起始地块的泥滩。"
msgstr "按 E 或点击「E ↷」，把新地块的泥滩转向右下方，对齐起始地块的泥滩。"

msgid "接长泥滩"
msgstr "接长泥滩"

msgid "点击棋盘上的金色六角空位。同类生境接边，会连成更大的区域。"
msgstr "点击棋盘上的金色六角空位。同类生境接边，会连成更大的区域。"

msgid "安置弹涂鱼"
msgstr "安置弹涂鱼"

msgid "点击新地块上的白色圆圈。弹涂鱼只能住进带弹涂鱼图标、还没住动物的格子。"
msgstr "点击新地块上的白色圆圈。弹涂鱼只能住进带弹涂鱼图标、还没住动物的格子。"

msgid "完成回合"
msgstr "完成回合"

msgid "看一眼版图上的试摆分数，再点击「完成回合」。确认前可以撤回摆放。"
msgstr "看一眼版图上的试摆分数，再点击「完成回合」。确认前可以撤回摆放。"

msgid "练习完成"
msgstr "练习完成"

msgid "首回合已经落定。点击「查看练习得分」，看看生境与动物分别怎样得分。"
msgstr "首回合已经落定。点击「查看练习得分」，看看生境与动物分别怎样得分。"

msgid "选取一组地块与动物，开始构筑你的生态世界。"
msgstr "选取一组地块与动物，开始构筑你的生态世界。"

msgid "潮 间 带 · 观 测 手 记"
msgstr "潮 间 带 · 观 测 手 记"

msgid "潮痕群岛"
msgstr "潮痕群岛"

msgid "退潮后，礁石与泥滩渐渐露出。\n沿着潮线，为五种动物留下栖身之处。"
msgstr "退潮后，礁石与泥滩渐渐露出。\n沿着潮线，为五种动物留下栖身之处。"

msgid "开始新的旅程"
msgstr "开始新的旅程"

msgid "首回合练习"
msgstr "首回合练习"

msgid "局域网联机"
msgstr "局域网联机"

msgid "继续上次旅程"
msgstr "继续上次旅程"

msgid "玩法说明"
msgstr "玩法说明"

msgid "设置"
msgstr "设置"

msgid "退出游戏"
msgstr "退出游戏"

msgid "1–4 位旅行者   /   20 回合   /   离线游玩"
msgstr "1–4 位旅行者   /   20 回合   /   离线游玩"

msgid "低潮调查 · 群岛生态记录"
msgstr "低潮调查 · 群岛生态记录"

msgid "已连接 %d / %d 位旅行者。"
msgstr "已连接 %d / %d 位旅行者。"

msgid "加入  %s  ·  %s/%s"
msgstr "加入  %s  ·  %s/%s"

msgid "正在连接房间……"
msgstr "正在连接房间……"

msgid "已连接房主，等待开局。"
msgstr "已连接房主，等待开局。"

msgid "连接中断，正在尝试重连（最多 120 秒）。"
msgstr "连接中断，正在尝试重连（最多 120 秒）。"

msgid "当前玩家断线，等待重连。"
msgstr "当前玩家断线，等待重连。"

msgid "正在连接……"
msgstr "正在连接……"

msgid "轮到 "
msgstr "轮到 "

msgid "请选择地块与动物。"
msgstr "请选择地块与动物。"

msgid "正在摆放，可等待或查看其他版图。"
msgstr "正在摆放，可等待或查看其他版图。"

msgid "联机提示"
msgstr "联机提示"

msgid "重新连接"
msgstr "重新连接"

msgid "练习旅行者"
msgstr "练习旅行者"

msgid "无法读取存档"
msgstr "无法读取存档"

msgid "存档无法读取。可以关闭此窗口并开始新的旅程。"
msgstr "存档无法读取。可以关闭此窗口并开始新的旅程。"

msgid "旅程已恢复，继续上次的选择。"
msgstr "旅程已恢复，继续上次的选择。"

msgid "自动存档写入失败，请检查磁盘空间。"
msgstr "自动存档写入失败，请检查磁盘空间。"

msgid "旅程完成"
msgstr "旅程完成"

msgid "回合完成"
msgstr "回合完成"

msgid "动物已刷新"
msgstr "动物已刷新"

msgid "选择完成后，点击「确认选取」。"
msgstr "选择完成后，点击「确认选取」。"

