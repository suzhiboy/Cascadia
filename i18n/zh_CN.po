msgid "旅行者 %d"
msgstr "旅行者 %d"

msgid "四枚同种动物过剩，已自动更换。"
msgstr "四枚同种动物过剩，已自动更换。"

msgid "请在选取地块前使用。"
msgstr "请在选取地块前使用。"

msgid "请选择至少一枚动物。"
msgstr "请选择至少一枚动物。"

msgid "无效的动物选择。"
msgstr "无效的动物选择。"

msgid "自然标记不足。"
msgstr "自然标记不足。"

msgid "每回合仅可免费更换一次三枚同种动物。"
msgstr "每回合仅可免费更换一次三枚同种动物。"

msgid "请选择三枚同种动物。"
msgstr "请选择三枚同种动物。"

msgid "请先完成当前回合。"
msgstr "请先完成当前回合。"

msgid "请选择市场中的地块与动物。"
msgstr "请选择市场中的地块与动物。"

msgid "跨组选取需要一枚自然标记。"
msgstr "跨组选取需要一枚自然标记。"

msgid "请先从市场选取。"
msgstr "请先从市场选取。"

msgid "地块须与已有地块共边，且不能重叠。"
msgstr "地块须与已有地块共边，且不能重叠。"

msgid "动物须放在有对应图标、且尚未入住的地块。"
msgstr "动物须放在有对应图标、且尚未入住的地块。"

msgid "请先选取动物。"
msgstr "请先选取动物。"

msgid "请摆放地块，并安置动物或选择放归。"
msgstr "请摆放地块，并安置动物或选择放归。"

msgid "未知的联机操作。"
msgstr "未知的联机操作。"

msgid "存档不兼容"
msgstr "存档不兼容"

msgid "巡护潮池"
msgstr "巡护潮池"

msgid "掘穴守潮"
msgstr "掘穴守潮"

msgid "每只招潮蟹得 2 分。自己的地块有泥滩，再加 1 分。"
msgstr "每只招潮蟹得 2 分。自己的地块有泥滩，再加 1 分。"

msgid "选择掘穴地点。"
msgstr "选择掘穴地点。"

msgid "开口迎潮"
msgstr "开口迎潮"

msgid "每只招潮蟹得 1 分。每两条面向图外空位的边再加 1 分，余下一条也加 1 分。"
msgstr "每只招潮蟹得 1 分。每两条面向图外空位的边再加 1 分，余下一条也加 1 分。"

msgid "把蟹穴放在有多个出入口的岸边。"
msgstr "把蟹穴放在有多个出入口的岸边。"

msgid "滩面食盘"
msgstr "滩面食盘"

msgid "共边连通的招潮蟹共享食场。每只得 1 分，群旁已铺且无动物的地块每格再得 3 分，同格只算一次。每群最多计入蟹数两倍的食场格。"
msgstr "共边连通的招潮蟹共享食场。每只得 1 分，群旁已铺且无动物的地块每格再得 3 分，同格只算一次。每群最多计入蟹数两倍的食场格。"

msgid "让整群蟹围住更多空滩。"
msgstr "让整群蟹围住更多空滩。"

msgid "潮线采样"
msgstr "潮线采样"

msgid "共边连通的招潮蟹每只得 1 分。查看群外相邻地块朝向蟹群的边，每种不同地貌再得 1 分。每群加分上限为蟹数的两倍。"
msgstr "共边连通的招潮蟹每只得 1 分。查看群外相邻地块朝向蟹群的边，每种不同地貌再得 1 分。每群加分上限为蟹数的两倍。"

msgid "用地块朝向给同群蟹引入不同潮线。"
msgstr "用地块朝向给同群蟹引入不同潮线。"

msgid "岩面啃藻"
msgstr "岩面啃藻"

msgid "每只帽贝得 1 分。本格及六个邻格中，每个带岩礁的地块再得 1 分，最多加 2 分。"
msgstr "每只帽贝得 1 分。本格及六个邻格中，每个带岩礁的地块再得 1 分，最多加 2 分。"

msgid "给帽贝安排相连的岩面。"
msgstr "给帽贝安排相连的岩面。"

msgid "两岸消浪"
msgstr "两岸消浪"

msgid "每只帽贝得 1 分。沿穿过它的三条直线查看紧邻两侧。两侧都有地块的直线每条加 1 分。"
msgstr "每只帽贝得 1 分。沿穿过它的三条直线查看紧邻两侧。两侧都有地块的直线每条加 1 分。"

msgid "在两侧都有遮蔽的狭口落脚。"
msgstr "在两侧都有遮蔽的狭口落脚。"

msgid "归壳潮痕"
msgstr "归壳潮痕"

msgid "每只帽贝得 1 分。若本格至少有一条边与邻格的对边地貌相同，加 2 分一次。"
msgstr "每只帽贝得 1 分。若本格至少有一条边与邻格的对边地貌相同，加 2 分一次。"

msgid "旋转地块留下连续的归壳路径。"
msgstr "旋转地块留下连续的归壳路径。"

msgid "壳层标本"
msgstr "壳层标本"

msgid "每只帽贝得 1 分。记录所有帽贝所在格的地貌组合，每种组合再得 1 分。双地貌的顺序与朝向均忽略。"
msgstr "每只帽贝得 1 分。记录所有帽贝所在格的地貌组合，每种组合再得 1 分。双地貌的顺序与朝向均忽略。"

msgid "分散帽贝，收齐不同底质上的壳层。"
msgstr "分散帽贝，收齐不同底质上的壳层。"

msgid "迎风起飞"
msgstr "迎风起飞"

msgid "每只燕鸥得 1 分。若有相连的两条边都面向图外空位，再加 2 分一次。"
msgstr "每只燕鸥得 1 分。若有相连的两条边都面向图外空位，再加 2 分一次。"

msgid "预留足够宽的起飞口。"
msgstr "预留足够宽的起飞口。"

msgid "掠岸航道"
msgstr "掠岸航道"

msgid "每只燕鸥得 1 分。沿六个方向各看两格。第一格有地块、第二格为图外空位的方向各加 1 分，最多加 2 分。"
msgstr "每只燕鸥得 1 分。沿六个方向各看两格。第一格有地块、第二格为图外空位的方向各加 1 分，最多加 2 分。"

msgid "沿一格宽的滩头起飞。"
msgstr "沿一格宽的滩头起飞。"

msgid "衔鱼归巢"
msgstr "衔鱼归巢"

msgid "每只燕鸥得 1 分。若从本格经至多两步共边的已铺地块可到达弹涂鱼，加 2 分一次。多只鸟可看见同一条鱼。"
msgstr "每只燕鸥得 1 分。若从本格经至多两步共边的已铺地块可到达弹涂鱼，加 2 分一次。多只鸟可看见同一条鱼。"

msgid "沿已铺的岸线把巢设在鱼群附近。"
msgstr "沿已铺的岸线把巢设在鱼群附近。"

msgid "迁徙落脚点"
msgstr "迁徙落脚点"

msgid "每只燕鸥得 1 分。从每只鸟沿直线跨过一格已铺地块，看第二格。第二格含砾滩或盐沼即为落脚点。全岛每个落脚点只加 1 分，总加分最多为燕鸥数的两倍。"
msgstr "每只燕鸥得 1 分。从每只鸟沿直线跨过一格已铺地块，看第二格。第二格含砾滩或盐沼即为落脚点。全岛每个落脚点只加 1 分，总加分最多为燕鸥数的两倍。"

msgid "分开航线，勘察不同的落脚点。"
msgstr "分开航线，勘察不同的落脚点。"

msgid "湿泥换气"
msgstr "湿泥换气"

msgid "每只弹涂鱼得 1 分。自己的地块含泥滩或潮池，再加 2 分一次。"
msgstr "每只弹涂鱼得 1 分。自己的地块含泥滩或潮池，再加 2 分一次。"

msgid "把鱼放回湿润的底质。"
msgstr "把鱼放回湿润的底质。"

msgid "跨滩换位"
msgstr "跨滩换位"

msgid "每只弹涂鱼得 1 分。相邻格与本格完全没有共同地貌，每格加 1 分，最多加 2 分。"
msgstr "每只弹涂鱼得 1 分。相邻格与本格完全没有共同地貌，每格加 1 分，最多加 2 分。"

msgid "让鱼能从一种底质跳到另一种。"
msgstr "让鱼能从一种底质跳到另一种。"

msgid "干湿轮替"
msgstr "干湿轮替"

msgid "每只弹涂鱼得 1 分。自己的地块和相邻格合起来同时出现泥滩与潮池，再加 2 分一次。双地貌可同时提供两种。"
msgstr "每只弹涂鱼得 1 分。自己的地块和相邻格合起来同时出现泥滩与潮池，再加 2 分一次。双地貌可同时提供两种。"

msgid "在陆上进食区与水下避难处之间留出转换空间。"
msgstr "在陆上进食区与水下避难处之间留出转换空间。"

msgid "横穿潮沟"
msgstr "横穿潮沟"

msgid "每只弹涂鱼得 2 分。穿过它的每条轴线，若两个紧邻格能分别提供泥滩和潮池，加 2 分。同一轴线只加一次。"
msgstr "每只弹涂鱼得 2 分。穿过它的每条轴线，若两个紧邻格能分别提供泥滩和潮池，加 2 分。同一轴线只加一次。"

msgid "把鱼放在互为对岸的泥滩与潮池之间。"
msgstr "把鱼放在互为对岸的泥滩与潮池之间。"

msgid "翻石觅食"
msgstr "翻石觅食"

msgid "每只水獭得 1 分。六个邻格内每出现一种猎物再加 1 分。猎物包括招潮蟹、帽贝和弹涂鱼。"
msgstr "每只水獭得 1 分。六个邻格内每出现一种猎物再加 1 分。猎物包括招潮蟹、帽贝和弹涂鱼。"

msgid "把水獭放到食物种类不同的岸边。"
msgstr "把水獭放到食物种类不同的岸边。"

msgid "背风育幼湾"
msgstr "背风育幼湾"

msgid "每只水獭得 1 分。若连续三条边的外侧都有地块，再加 2 分一次。连续可跨越六边形的首尾。"
msgstr "每只水獭得 1 分。若连续三条边的外侧都有地块，再加 2 分一次。连续可跨越六边形的首尾。"

msgid "用连续岸壁围出背风湾。"
msgstr "用连续岸壁围出背风湾。"

msgid "上岸晾毛"
msgstr "上岸晾毛"

msgid "每只水獭得 1 分。若紧邻一格尚无动物的砾滩或岩礁，加 4 分一次。其他水獭可以共用这格岸。"
msgstr "每只水獭得 1 分。若紧邻一格尚无动物的砾滩或岩礁，加 4 分一次。其他水獭可以共用这格岸。"

msgid "为水獭保留一块空闲的干岸。"
msgstr "为水獭保留一块空闲的干岸。"

msgid "水域巡护"
msgstr "水域巡护"

msgid "每只水獭得 1 分。水獭本格或共边邻格有潮池，即巡护该片潮池。对边同为潮池的地块相连成片。每片按地块数加分，最多加 3 分，多只水獭共用只算一次。"
msgstr "每只水獭得 1 分。水獭本格或共边邻格有潮池，即巡护该片潮池。对边同为潮池的地块相连成片。每片按地块数加分，最多加 3 分，多只水獭共用只算一次。"

msgid "在不同潮池之间安排巡护范围。"
msgstr "在不同潮池之间安排巡护范围。"

msgid "招潮蟹"
msgstr "招潮蟹"

msgid "帽贝"
msgstr "帽贝"

msgid "弹涂鱼"
msgstr "弹涂鱼"

msgid "燕鸥"
msgstr "燕鸥"

msgid "水獭"
msgstr "水獭"

msgid "岩礁"
msgstr "岩礁"

msgid "盐沼"
msgstr "盐沼"

msgid "砾滩"
msgstr "砾滩"

msgid "泥滩"
msgstr "泥滩"

msgid "潮池"
msgstr "潮池"

msgid "联机协议版本不兼容。"
msgstr "联机协议版本不兼容。"

msgid "无效的联机命令。"
msgstr "无效的联机命令。"

msgid "无效的联机参数。"
msgstr "无效的联机参数。"

msgid "房主"
msgstr "房主"

msgid "只有未开始的房主可以开局。"
msgstr "只有未开始的房主可以开局。"

msgid "请等待所有玩家连接并准备。"
msgstr "请等待所有玩家连接并准备。"

msgid "重连超时，联机房间已结束。"
msgstr "重连超时，联机房间已结束。"

msgid "玩家重连超时，房间已结束。"
msgstr "玩家重连超时，房间已结束。"

msgid "还没轮到这位玩家。"
msgstr "还没轮到这位玩家。"

msgid "操作已处理，请勿重复发送。"
msgstr "操作已处理，请勿重复发送。"

msgid "版本不同，请两位玩家使用同一份最新游戏包。"
msgstr "版本不同，请两位玩家使用同一份最新游戏包。"

msgid "房间已开局，不能加入新玩家。"
msgstr "房间已开局，不能加入新玩家。"

msgid "房间已满，请选择其他房间。"
msgstr "房间已满，请选择其他房间。"

msgid "旅行者"
msgstr "旅行者"

msgid "连接失败。请检查房主热点 IPv4 地址、UDP 35721 防火墙放行及热点是否允许设备互访。"
msgstr "连接失败。请检查房主热点 IPv4 地址、UDP 35721 防火墙放行及热点是否允许设备互访。"

msgid "入住："
msgstr "入住："

msgid "可入住："
msgstr "可入住："

msgid "选取一组"
msgstr "选取一组"

msgid "点击左侧金边的第 1 组。点地块或弹涂鱼都可以，两件会一起选中。"
msgstr "点击左侧金边的第 1 组。点地块或弹涂鱼都可以，两件会一起选中。"

msgid "领取样区"
msgstr "领取样区"

msgid "点击市集下方的「确认选取」，把这组地块和弹涂鱼领取样区。"
msgstr "点击市集下方的「确认选取」，把这组地块和弹涂鱼领取样区。"

msgid "转一转地块"
msgstr "转一转地块"

msgid "按 E 或点击「E ↷」，把新地块的泥滩转向右下方，对齐起始地块的泥滩。"
msgstr "按 E 或点击「E ↷」，把新地块的泥滩转向右下方，对齐起始地块的泥滩。"

msgid "接长泥滩"
msgstr "接长泥滩"

msgid "点击棋盘上的金色六角空位。同类生境接边，会连成更大的区域。"
msgstr "点击棋盘上的金色六角空位。同类生境接边，会连成更大的区域。"

msgid "安置弹涂鱼"
msgstr "安置弹涂鱼"

msgid "点击新地块上的白色圆圈。弹涂鱼只能住进带弹涂鱼图标、还没住动物的格子。"
msgstr "点击新地块上的白色圆圈。弹涂鱼只能住进带弹涂鱼图标、还没住动物的格子。"

msgid "完成回合"
msgstr "完成回合"

msgid "看一眼上方的试摆分差，再点击「完成回合」。确认前可以撤回摆放。"
msgstr "看一眼上方的试摆分差，再点击「完成回合」。确认前可以撤回摆放。"

msgid "练习完成"
msgstr "练习完成"

msgid "首回合已经落定。点击「查看练习得分」，看看生境与动物分别怎样得分。"
msgstr "首回合已经落定。点击「查看练习得分」，看看生境与动物分别怎样得分。"

msgid "选取一组地块与动物，开始构筑你的生态世界。"
msgstr "选取一组地块与动物，开始构筑你的生态世界。"

msgid "潮 间 带 · 观 测 手 记"
msgstr "潮 间 带 · 观 测 手 记"

msgid "潮痕群岛"
msgstr "潮痕群岛"

msgid "退潮后，礁石与泥滩渐渐露出。\n沿着潮线，为五种动物留下栖身之处。"
msgstr "退潮后，礁石与泥滩渐渐露出。\n沿着潮线，为五种动物留下栖身之处。"

msgid "开始新的旅程"
msgstr "开始新的旅程"

msgid "首回合练习"
msgstr "首回合练习"

msgid "局域网联机"
msgstr "局域网联机"

msgid "继续上次旅程"
msgstr "继续上次旅程"

msgid "玩法说明"
msgstr "玩法说明"

msgid "设置"
msgstr "设置"

msgid "退出游戏"
msgstr "退出游戏"

msgid "1–4 位旅行者   /   20 回合   /   离线游玩"
msgstr "1–4 位旅行者   /   20 回合   /   离线游玩"

msgid "低潮调查 · 群岛生态记录"
msgstr "低潮调查 · 群岛生态记录"

msgid "已连接 %d / %d 位旅行者。"
msgstr "已连接 %d / %d 位旅行者。"

msgid "加入  %s  ·  %s/%s"
msgstr "加入  %s  ·  %s/%s"

msgid "正在连接房间……"
msgstr "正在连接房间……"

msgid "已连接房主，等待开局。"
msgstr "已连接房主，等待开局。"

msgid "连接中断，正在尝试重连（最多 120 秒）。"
msgstr "连接中断，正在尝试重连（最多 120 秒）。"

msgid "当前玩家断线，等待重连。"
msgstr "当前玩家断线，等待重连。"

msgid "正在连接……"
msgstr "正在连接……"

msgid "轮到 "
msgstr "轮到 "

msgid "请选择地块与动物。"
msgstr "请选择地块与动物。"

msgid "正在摆放，可等待或查看其他版图。"
msgstr "正在摆放，可等待或查看其他版图。"

msgid "联机提示"
msgstr "联机提示"

msgid "重新连接"
msgstr "重新连接"

msgid "练习旅行者"
msgstr "练习旅行者"

msgid "无法读取存档"
msgstr "无法读取存档"

msgid "存档无法读取。可以关闭此窗口并开始新的旅程。"
msgstr "存档无法读取。可以关闭此窗口并开始新的旅程。"

msgid "旅程已恢复，继续上次的选择。"
msgstr "旅程已恢复，继续上次的选择。"

msgid "自动存档写入失败，请检查磁盘空间。"
msgstr "自动存档写入失败，请检查磁盘空间。"

msgid "旅程完成"
msgstr "旅程完成"

msgid "回合完成"
msgstr "回合完成"

msgid "动物已刷新"
msgstr "动物已刷新"

